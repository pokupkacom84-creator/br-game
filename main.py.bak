# -*- coding: utf-8 -*-
"""Flux payment bot.

Important: secrets are loaded from environment variables. Do not commit them to git.
"""
import asyncio
import logging
import os
import random
import time
from typing import Any, Dict, Optional, Tuple

from aiogram import Bot, Dispatcher, F
from aiogram.filters import CommandStart
from aiogram.types import CallbackQuery, InlineKeyboardButton, InlineKeyboardMarkup, Message
from aiogram.client.default import DefaultBotProperties

import firebase_admin
from firebase_admin import credentials, db as fbdb

# ================= CONFIG =================
BOT_TOKEN = os.getenv("BOT_TOKEN", "").strip()
ADMIN_ID = int(os.getenv("ADMIN_ID", "0"))
FIREBASE_CRED = os.getenv("FIREBASE_CRED", "serviceAccountKey.json")
FIREBASE_URL = os.getenv("FIREBASE_URL", "https://game-cd07d-default-rtdb.firebaseio.com")

CARD_NUMBER = os.getenv("PAYMENT_CARD", "").strip()
BANK_NAME = os.getenv("PAYMENT_BANK_NAME", "ЮMoney").strip()
BANK_NUMBER = os.getenv("PAYMENT_BANK_NUMBER", "").strip()

PREMIUM_PLANS = {
    "pm_month": {"plan": "month", "rub": 199, "days": 30, "title": "Премиум · 1 месяц"},
    "pm_quarter": {"plan": "quarter", "rub": 499, "days": 90, "title": "Премиум · 3 месяца"},
    "pm_year": {"plan": "year", "rub": 1490, "days": 365, "title": "Премиум · 1 год"},
}
STAR_PACKS = {
    "p1": {"stars": 100, "rub": 19, "title": "100 звёзд"},
    "p2": {"stars": 300, "rub": 49, "title": "300 звёзд"},
    "p3": {"stars": 800, "rub": 99, "title": "800 звёзд"},
    "p4": {"stars": 2000, "rub": 199, "title": "2 000 звёзд"},
    "p5": {"stars": 5000, "rub": 449, "title": "5 000 звёзд"},
    "p6": {"stars": 12000, "rub": 999, "title": "12 000 звёзд"},
}

RATE_LIMIT_MS = 5 * 60 * 1000
PENDING_TTL_MS = 24 * 3600 * 1000

logging.basicConfig(level=logging.INFO, format="%(asctime)s | %(levelname)s | %(message)s")

if not BOT_TOKEN:
    raise RuntimeError("BOT_TOKEN is not set")
if ADMIN_ID <= 0:
    raise RuntimeError("ADMIN_ID is not set or invalid")
if not CARD_NUMBER or not BANK_NUMBER:
    raise RuntimeError("PAYMENT_CARD and PAYMENT_BANK_NUMBER must be set")

if not firebase_admin._apps:
    cred = credentials.Certificate(FIREBASE_CRED)
    firebase_admin.initialize_app(cred, {"databaseURL": FIREBASE_URL})

bot = Bot(token=BOT_TOKEN, default=DefaultBotProperties(parse_mode="HTML"))
dp = Dispatcher()

# ---------- Firebase helpers ----------
def fb_get(path: str):
    return fbdb.reference(path).get()


def fb_set(path: str, value: Any):
    return fbdb.reference(path).set(value)


def fb_update(path: str, value: Dict[str, Any]):
    return fbdb.reference(path).update(value)


def fb_increment(path: str, delta: int):
    def _tx(cur):
        try:
            cur = int(cur or 0)
        except (TypeError, ValueError):
            cur = 0
        return cur + delta
    return fbdb.reference(path).transaction(_tx)


def fb_claim_payment(path: str) -> Optional[Dict[str, Any]]:
    """Atomically move a payable request into processing.

    This prevents two admin callbacks from crediting the same request twice.
    """
    def _tx(cur):
        if not isinstance(cur, dict):
            return cur
        if cur.get("status") not in ("pending", "awaiting") or cur.get("credited") is True:
            return cur
        cur = dict(cur)
        cur["status"] = "processing"
        cur["processingAt"] = now_ms()
        return cur

    result = fbdb.reference(path).transaction(_tx)
    value = result
    if not isinstance(value, dict) or value.get("status") != "processing":
        return None
    return value


async def run_blocking(func, *args):
    loop = asyncio.get_running_loop()
    return await loop.run_in_executor(None, func, *args)


async def fb_get_async(path):
    return await run_blocking(fb_get, path)


async def fb_set_async(path, value):
    return await run_blocking(fb_set, path, value)


async def fb_update_async(path, value):
    return await run_blocking(fb_update, path, value)


async def fb_increment_async(path, delta):
    return await run_blocking(fb_increment, path, delta)


async def fb_claim_payment_async(path):
    return await run_blocking(fb_claim_payment, path)


# ---------- Utils ----------
def is_admin(uid: int) -> bool:
    return uid == ADMIN_ID


def gen_code(uid: str) -> str:
    tail = "".join(ch for ch in str(uid) if ch.isalnum())[-4:].upper() or "0000"
    return f"F{tail}{random.SystemRandom().randint(1000, 9999)}"


def now_ms() -> int:
    return int(time.time() * 1000)


def fmt_wait(sec: int) -> str:
    m, s = max(0, int(sec)) // 60, max(0, int(sec)) % 60
    return f"{m} мин {s} сек" if m else f"{s} сек"


def fmt_date(ms: int) -> str:
    return time.strftime("%d.%m.%Y %H:%M", time.localtime(ms / 1000))


def parse_payload(payload: str) -> Optional[Tuple[str, str]]:
    """Payment payload is <uid>_<item>; split only at the last underscore."""
    if not payload or "_" not in payload:
        return None
    uid, item_id = payload.rsplit("_", 1)
    if not uid or not item_id or len(uid) > 200 or len(item_id) > 50:
        return None
    return uid, item_id


def payment_item(item_id: str):
    if item_id in PREMIUM_PLANS:
        return "premium", PREMIUM_PLANS[item_id]
    if item_id in STAR_PACKS:
        return "stars", STAR_PACKS[item_id]
    return None, None


# ================= Support / Terms =================
@dp.message(F.text == "/paysupport")
async def cmd_paysupport(message: Message):
    await message.answer(
        "🛟 <b>Поддержка платежей Flux</b>\n\n"
        "Если оплата прошла, но покупка не активировалась, отправьте сюда Telegram ID, код платежа и примерное время перевода."
    )


@dp.message(F.text == "/terms")
async def cmd_terms(message: Message):
    await message.answer(
        "📄 <b>Условия покупки Flux Premium</b>\n\n"
        "Premium и звёзды оплачиваются в рублях по реквизитам, которые показывает бот. После перевода пользователь отправляет скриншот, администратор проверяет платеж и подтверждает заявку.\n\n"
        "Проблемы с покупкой: /paysupport"
    )


# ================= /start =================
@dp.message(CommandStart())
async def start_handler(message: Message):
    if is_admin(message.from_user.id):
        await message.answer("Админ-режим активен. Заявки пользователей приходят сюда.")
        return

    args = (message.text or "").split(maxsplit=1)
    payload = args[1].strip() if len(args) > 1 else ""
    parsed = parse_payload(payload)
    if not parsed:
        await message.answer(
            "👋 <b>Flux</b>\n\n"
            "Откройте в приложении <b>Магазин</b> и выберите Premium или пакет звёзд.\n"
            "Оплата — в рублях. После перевода отправьте скриншот сюда."
        )
        return

    uid, item_id = parsed
    pay_type, item = payment_item(item_id)
    if not item:
        await message.answer("⚠️ Товар не найден. Откройте магазин Flux и начните оплату заново.")
        return

    try:
        user_data = await fb_get_async(f"users/{uid}")
    except Exception:
        logging.exception("Failed to load user %s", uid)
        await message.answer("⚠️ Временная ошибка сервера. Попробуйте ещё раз через минуту.")
        return

    if not isinstance(user_data, dict) or not user_data.get("name"):
        await message.answer(
            f"⚠️ Пользователь Flux не найден.\nUID: <code>{uid}</code>\n"
            "Войдите в приложение и попробуйте снова."
        )
        return

    tg_user_id = message.from_user.id
    now = now_ms()
    try:
        old_pays = await fb_get_async(f"payments/{uid}") or {}
    except Exception:
        logging.exception("Failed to load payments for %s", uid)
        await message.answer("⚠️ Не удалось открыть оплату. Попробуйте ещё раз.")
        return

    if not isinstance(old_pays, dict):
        old_pays = {}

    # Keep one active request per payment type. A request for another pack is
    # not silently cancelled; this avoids losing a valid pending payment.
    fresh_pending = None
    for old_rid, old_p in old_pays.items():
        if not isinstance(old_p, dict):
            continue
        if old_p.get("status") not in ("pending", "awaiting") or old_p.get("type") != pay_type:
            continue
        try:
            age = now - int(old_p.get("createdAt", 0) or 0)
        except (TypeError, ValueError):
            age = RATE_LIMIT_MS + 1
        if age < RATE_LIMIT_MS:
            fresh_pending = {"rid": old_rid, "pay": old_p, "age_ms": age}
            break

    if fresh_pending:
        p = fresh_pending["pay"]
        wait_sec = max(1, int((RATE_LIMIT_MS - fresh_pending["age_ms"]) / 1000))
        title = p.get("itemLabel", item.get("title", "Покупка"))
        await message.answer(
            f"⏳ <b>Заявка уже создана</b>\n\n"
            f"{title} · <b>{p.get('rub', item['rub'])} ₽</b>\n"
            f"🔑 Код: <code>{p.get('code', '—')}</code>\n\n"
            "📸 Отправьте скриншот перевода в этот чат.\n\n"
            f"⏱ Новая заявка для этого типа оплаты через <b>{fmt_wait(wait_sec)}</b>."
        )
        return

    code = gen_code(uid)
    item_label = f"👑 {item['title']}" if pay_type == "premium" else f"⭐ {item['title']}"
    req_data = {
        "userId": uid,
        "tgUserId": tg_user_id,
        "userName": str(user_data.get("name", ""))[:120],
        "username": str(user_data.get("username", ""))[:64],
        "packId": item_id,
        "type": pay_type,
        "rub": int(item["rub"]),
        "code": code,
        "status": "pending",
        "credited": False,
        "source": "rub_manual",
        "itemLabel": item_label,
        "createdAt": now,
    }
    if pay_type == "premium":
        req_data.update({"plan": item["plan"], "days": item["days"]})
    else:
        req_data.update({"stars": item["stars"]})

    try:
        ref = await run_blocking(lambda: fbdb.reference(f"payments/{uid}").push(req_data))
    except Exception:
        logging.exception("Failed to create payment request for %s", uid)
        await message.answer("⚠️ Не удалось создать заявку. Попробуйте ещё раз.")
        return

    product_text = f"👑 <b>{item['title']}</b>" if pay_type == "premium" else f"⭐ <b>{item['title']}</b>"
    after = (
        "Администратор проверит перевод и активирует Premium."
        if pay_type == "premium"
        else "После подтверждения звёзды автоматически зачислятся на баланс Flux."
    )
    await message.answer(
        f"{product_text}\n\n"
        f"К оплате: <b>{item['rub']} ₽</b>\n"
        f"Код платежа: <code>{code}</code>\n\n"
        "<b>Реквизиты:</b>\n"
        f"💳 Карта: <code>{CARD_NUMBER}</code>\n"
        f"📱 {BANK_NAME}: <code>{BANK_NUMBER}</code>\n\n"
        f"⚠️ Укажите код <code>{code}</code> в комментарии к переводу.\n\n"
        "📸 После оплаты отправьте <b>скриншот</b> в этот чат.\n"
        f"{after}"
    )
    logging.info("RUB request %s · uid=%s · type=%s · item=%s", ref.key, uid, pay_type, item_id)


# ================= Screenshot intake =================
@dp.message(F.photo)
async def handle_screenshot(message: Message):
    if is_admin(message.from_user.id):
        await message.answer("Это админ-аккаунт. Скриншоты — от пользователей.")
        return

    tg_user_id = message.from_user.id
    try:
        all_pays = await fb_get_async("payments") or {}
    except Exception:
        logging.exception("Failed to load payments")
        await message.answer("⚠️ Не удалось проверить заявку. Попробуйте ещё раз.")
        return

    now = now_ms()
    found = None
    if isinstance(all_pays, dict):
        for uid, reqs in all_pays.items():
            if not isinstance(reqs, dict):
                continue
            for rid, p in reqs.items():
                if not isinstance(p, dict) or p.get("status") != "pending":
                    continue
                if p.get("tgUserId") != tg_user_id:
                    continue
                try:
                    age = now - int(p.get("createdAt", 0) or 0)
                except (TypeError, ValueError):
                    age = PENDING_TTL_MS + 1
                if age > PENDING_TTL_MS:
                    continue
                found = {"uid": uid, "rid": rid, "pay": p}
                break
            if found:
                break

    if not found:
        await message.answer(
            "⚠️ Не нашёл активную заявку.\n\n"
            "Откройте оплату заново: <b>Магазин</b> в приложении."
        )
        return

    file_id = message.photo[-1].file_id
    payment_path = f"payments/{found['uid']}/{found['rid']}"
    try:
        await fb_update_async(payment_path, {
            "status": "awaiting",
            "proofImageFileId": file_id,
            "paidAt": now,
        })
    except Exception:
        logging.exception("Failed to store proof for %s", payment_path)
        await message.answer("⚠️ Не удалось сохранить скриншот. Попробуйте отправить его ещё раз.")
        return

    pay = found["pay"]
    type_icon = "👑" if pay.get("type") == "premium" else "⭐"
    item_label = pay.get("itemLabel", "")
    caption = (
        "🟡 <b>Новая заявка</b>\n\n"
        f"👤 {pay.get('userName', '—')} "
        f"{('@' + str(pay.get('username'))) if pay.get('username') else ''}\n"
        f"🆔 UID: <code>{found['uid']}</code>\n"
        f"📱 TG: <code>{tg_user_id}</code>\n"
        f"{type_icon} {item_label}\n"
        f"💰 {pay.get('rub', 0)} ₽\n"
        f"🔑 Код: <code>{pay.get('code', '—')}</code>"
    )
    markup = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(text="✅ Подтвердить", callback_data=f"confirm:{found['uid']}:{found['rid']}"),
        InlineKeyboardButton(text="❌ Отклонить", callback_data=f"reject:{found['uid']}:{found['rid']}"),
    ]])

    try:
        await bot.send_photo(ADMIN_ID, file_id, caption=caption, reply_markup=markup)
    except Exception:
        logging.exception("Failed to notify admin")
        # Return the request to pending so the user can retry instead of
        # falsely reporting that the admin received the proof.
        try:
            await fb_update_async(payment_path, {"status": "pending", "proofImageFileId": None, "paidAt": None})
        except Exception:
            logging.exception("Failed to rollback payment proof")
        await message.answer("⚠️ Не удалось отправить скриншот администратору. Попробуйте ещё раз.")
        return

    await message.answer("✅ Скриншот получен и отправлен на проверку.")


# ================= Confirmation =================
@dp.callback_query(F.data.startswith("confirm:"))
async def cb_confirm(callback: CallbackQuery):
    if not is_admin(callback.from_user.id):
        await callback.answer("Нет доступа", show_alert=True)
        return

    parts = (callback.data or "").split(":", 2)
    if len(parts) != 3:
        await callback.answer("Ошибка данных заявки", show_alert=True)
        return
    _, uid, rid = parts
    path = f"payments/{uid}/{rid}"

    try:
        pay = await fb_get_async(path)
    except Exception:
        logging.exception("Payment read error %s", path)
        await callback.answer("Ошибка Firebase", show_alert=True)
        return

    if not isinstance(pay, dict):
        await callback.answer("Заявка не найдена", show_alert=True)
        return
    if pay.get("status") == "confirmed" or pay.get("credited") is True:
        await callback.answer("Уже подтверждена", show_alert=True)
        return
    if pay.get("status") not in ("pending", "awaiting"):
        await callback.answer(f"Заявка уже закрыта: {pay.get('status', 'unknown')}", show_alert=True)
        return

    # Atomic claim closes the double-click / two-admin race.
    try:
        claimed = await fb_claim_payment_async(path)
    except Exception:
        logging.exception("Payment claim error %s", path)
        await callback.answer("Ошибка Firebase", show_alert=True)
        return
    if not claimed:
        await callback.answer("Заявка уже обрабатывается другим администратором", show_alert=True)
        return

    await callback.answer("⏳ Подтверждаю…")
    kind = claimed.get("type")
    now = now_ms()

    try:
        if kind == "premium":
            plan_id = claimed.get("packId")
            plan = PREMIUM_PLANS.get(plan_id)
            if not plan:
                raise ValueError(f"Тариф Premium не найден: {plan_id}")

            days = int(plan["days"])
            user_prem = await fb_get_async(f"users/{uid}/premium")
            user_prem = user_prem if isinstance(user_prem, dict) else {}
            try:
                cur_exp = int(user_prem.get("expiresAt", 0) or 0)
            except (TypeError, ValueError):
                cur_exp = 0
            try:
                since = int(user_prem.get("since", now) or now)
            except (TypeError, ValueError):
                since = now

            if cur_exp > now and user_prem.get("active") is True:
                new_exp = cur_exp + days * 86400000
                action = "продлён"
            else:
                new_exp = now + days * 86400000
                since = now
                action = "активирован"

            await fb_update_async(f"users/{uid}/premium", {
                "active": True,
                "plan": plan["plan"],
                "expiresAt": new_exp,
                "since": since,
                "days": days,
                "rub": plan["rub"],
                "lastPaymentId": rid,
                "lastPaymentCurrency": "RUB",
            })
            result_text = f"\n\n✅ <b>Подтверждено</b>\n👑 Премиум {action}\n📅 До: <b>{fmt_date(new_exp)}</b>"
            user_msg = f"🎉 <b>Оплата подтверждена!</b>\n\n👑 Премиум {action}\n📅 Действует до: <b>{fmt_date(new_exp)}</b>\n\nОткройте Flux — Premium уже активен."

        elif kind == "stars":
            pack_id = claimed.get("packId")
            pack = STAR_PACKS.get(pack_id)
            if not pack:
                raise ValueError(f"Пакет звёзд не найден: {pack_id}")
            stars = int(pack["stars"])
            if stars <= 0:
                raise ValueError("Некорректное количество звёзд")
            new_balance = int(await fb_increment_async(f"users/{uid}/stars", stars) or 0)
            result_text = f"\n\n✅ <b>Подтверждено</b>\n⭐ Начислено: <b>{stars:,}</b> звёзд\n💰 Новый баланс: <b>{new_balance:,}</b>".replace(",", " ")
            user_msg = f"🎉 <b>Оплата подтверждена!</b>\n\n⭐ Вам начислено <b>{stars:,}</b> звёзд.\n💰 Баланс: <b>{new_balance:,}</b>\n\nТеперь их можно тратить на подарки в Flux.".replace(",", " ")
        else:
            raise ValueError(f"Неизвестный тип заявки: {kind!r}")

        await fb_update_async(path, {
            "status": "confirmed",
            "credited": True,
            "confirmedAt": now,
            "confirmedBy": callback.from_user.id,
        })
    except Exception as exc:
        logging.exception("Confirmation failed %s", path)
        try:
            await fb_update_async(path, {"status": "awaiting", "lastError": str(exc)[:500], "lastErrorAt": now_ms()})
        except Exception:
            logging.exception("Failed to restore payment state %s", path)
        try:
            await callback.message.edit_reply_markup(reply_markup=None)
        except Exception:
            pass
        await callback.message.reply(
            "⚠️ <b>Не удалось подтвердить заявку.</b>\n"
            f"Ошибка: <code>{str(exc)[:350]}</code>\n\n"
            "Заявка оставлена в ожидании."
        )
        return

    try:
        if callback.message and callback.message.caption is not None:
            await callback.message.edit_caption(caption=(callback.message.caption or "") + result_text, reply_markup=None)
        else:
            await callback.message.edit_reply_markup(reply_markup=None)
    except Exception:
        logging.exception("Failed to update admin message %s", path)

    tg_uid = claimed.get("tgUserId")
    if tg_uid:
        try:
            await bot.send_message(tg_uid, user_msg)
        except Exception:
            logging.exception("Failed to notify user tg=%s", tg_uid)


# ================= Rejection =================
@dp.callback_query(F.data.startswith("reject:"))
async def cb_reject(callback: CallbackQuery):
    if not is_admin(callback.from_user.id):
        await callback.answer("Нет доступа", show_alert=True)
        return
    parts = (callback.data or "").split(":", 2)
    if len(parts) != 3:
        await callback.answer("Ошибка данных заявки", show_alert=True)
        return
    _, uid, rid = parts
    path = f"payments/{uid}/{rid}"
    try:
        pay = await fb_get_async(path)
    except Exception:
        logging.exception("Payment read error %s", path)
        await callback.answer("Ошибка Firebase", show_alert=True)
        return
    if not isinstance(pay, dict):
        await callback.answer("Заявка не найдена", show_alert=True)
        return
    if pay.get("status") == "rejected":
        await callback.answer("Уже отклонена", show_alert=True)
        return
    if pay.get("status") == "confirmed" or pay.get("credited") is True:
        await callback.answer("Уже подтверждена", show_alert=True)
        return

    await callback.answer("⏳ Отклоняю…")
    await fb_update_async(path, {"status": "rejected", "rejectedAt": now_ms(), "reason": "Отклонено администратором"})
    try:
        await callback.message.edit_caption(caption=(callback.message.caption or "") + "\n\n❌ <b>Отклонено</b>", reply_markup=None)
    except Exception:
        try:
            await callback.message.edit_reply_markup(reply_markup=None)
        except Exception:
            pass

    tg_uid = pay.get("tgUserId")
    if tg_uid:
        try:
            await bot.send_message(tg_uid, "❌ Ваша заявка отклонена. Если это ошибка — напишите администратору.")
        except Exception:
            logging.exception("Failed to notify user tg=%s", tg_uid)


# ================= Admin stats =================
@dp.message(F.text == "/stats")
async def cmd_stats(message: Message):
    if not is_admin(message.from_user.id):
        return

    def _count():
        all_pays = fbdb.reference("payments").get() or {}
        counters = {"pending": 0, "confirmed": 0, "rejected": 0, "cancelled": 0, "processing": 0}
        if isinstance(all_pays, dict):
            for reqs in all_pays.values():
                if not isinstance(reqs, dict):
                    continue
                for p in reqs.values():
                    if isinstance(p, dict) and p.get("type") in ("premium", "stars"):
                        st = p.get("status")
                        if st in counters:
                            counters[st] += 1
                        elif st == "awaiting":
                            counters["pending"] += 1
        return counters

    c = await run_blocking(_count)
    await message.answer(
        "📊 <b>Статистика</b>\n\n"
        f"🟡 В ожидании: {c['pending']}\n"
        f"🔵 Обрабатываются: {c['processing']}\n"
        f"✅ Подтверждено: {c['confirmed']}\n"
        f"❌ Отклонено: {c['rejected']}\n"
        f"⚫ Отменено: {c['cancelled']}"
    )


# ================= Cleanup =================
@dp.message(F.text == "/cleanup")
async def cmd_cleanup(message: Message):
    if not is_admin(message.from_user.id):
        return

    def _clean():
        all_pays = fbdb.reference("payments").get() or {}
        now = now_ms()
        removed = 0
        if not isinstance(all_pays, dict):
            return 0
        for uid, reqs in all_pays.items():
            if not isinstance(reqs, dict):
                continue
            for rid, p in reqs.items():
                if not isinstance(p, dict):
                    continue
                if p.get("status") in ("pending", "awaiting"):
                    try:
                        age = now - int(p.get("createdAt", 0) or 0)
                    except (TypeError, ValueError):
                        age = PENDING_TTL_MS + 1
                    if age > PENDING_TTL_MS:
                        fbdb.reference(f"payments/{uid}/{rid}").update({"status": "cancelled", "cancelledAt": now})
                        removed += 1
        return removed

    removed = await run_blocking(_clean)
    await message.answer(f"🧹 Отменено просроченных заявок: <b>{removed}</b>")


# ================= Startup =================
async def main():
    logging.info("Flux payment bot started")
    await bot.delete_webhook(drop_pending_updates=True)
    try:
        await dp.start_polling(bot)
    finally:
        await bot.session.close()


if __name__ == "__main__":
    asyncio.run(main())
